</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (!reduced) {
    // 1. Hero masked split-line entrance
    gsap.from('.js-hero-line', {
      yPercent: 115,
      duration: 1.05,
      ease: 'power4.out',
      stagger: 0.12,
    });

    gsap.from('.js-hero-fade', {
      opacity: 0,
      y: 20,
      duration: 0.85,
      delay: 0.25,
      ease: 'power3.out',
      stagger: 0.1,
    });

    // 2. Hero stage cinema scroll expansion + parallax
    const heroStage = document.getElementById('heroStage');
    const heroStageImg = document.getElementById('heroStageImg');
    if (heroStage && heroStageImg) {
      gsap.to(heroStage, {
        borderRadius: '0px',
        maxWidth: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: '#heroStageOuter',
          start: 'top 80%',
          end: 'top 10%',
          scrub: true,
        },
      });

      gsap.to(heroStageImg, {
        scale: 1,
        yPercent: 6,
        ease: 'none',
        scrollTrigger: {
          trigger: '#heroStageOuter',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    // 3. Word-by-word scroll-illuminated manifesto
    const words = document.querySelectorAll('#manifestoText .m-word');
    if (words.length > 0) {
      gsap.to(words, {
        opacity: 1,
        stagger: 0.08,
        ease: 'none',
        scrollTrigger: {
          trigger: '#manifestoText',
          start: 'top 80%',
          end: 'bottom 45%',
          scrub: 0.6,
        },
      });
    }

    // 4. Reveal cards smoothly on scroll
    document.querySelectorAll<HTMLElement>('.js-reveal-up').forEach((el) => {
      gsap.from(el, {
        opacity: 0,
        y: 28,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 86%',
          once: true,
        },
      });
    });

    // 5. Sticky stacking card subtle depth scale-down
    const stackCards = gsap.utils.toArray<HTMLElement>('.js-stack-card');
    if (window.innerWidth > 640 && stackCards.length > 1) {
      stackCards.forEach((card, i) => {
        if (i === stackCards.length - 1) return;
        gsap.to(card, {
          scale: 0.94,
          opacity: 0.72,
          ease: 'none',
          scrollTrigger: {
            trigger: stackCards[i + 1],
            start: 'top 75%',
            end: 'top 25%',
            scrub: true,
          },
        });
      });
    }
  } else {
    document.querySelectorAll<HTMLElement>('.m-word').forEach((w) => {
      w.style.opacity = '1';
    });
  }

  // 6. Desktop Awwwards Cursor-Following Service Photo Preview
  if (isDesktop && !reduced) {
    const preview = document.getElementById('hoverPreview');
    const previewImg = document.getElementById('hoverPreviewImg') as HTMLImageElement | null;
    const rows = document.querySelectorAll<HTMLElement>('.service-row');

    if (preview && previewImg && rows.length > 0) {
      const moveX = gsap.quickTo(preview, 'x', { duration: 0.38, ease: 'power3.out' });
      const moveY = gsap.quickTo(preview, 'y', { duration: 0.38, ease: 'power3.out' });
      let lastX = 0;

      rows.forEach((row) => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.previewImg;
          if (src) previewImg.src = src;
          gsap.to(preview, { opacity: 1, scale: 1, duration: 0.3, ease: 'power3.out' });
        });

        row.addEventListener('mousemove', (e) => {
          const vx = Math.max(-10, Math.min(10, (e.clientX - lastX) * 0.45));
          lastX = e.clientX;
          moveX(e.clientX + 26);
          moveY(e.clientY - 12);
          gsap.to(preview, { rotation: vx * 0.45, duration: 0.35, ease: 'power2.out' });
        });

        row.addEventListener('mouseleave', () => {
          gsap.to(preview, { opacity: 0, scale: 0.84, rotation: 0, duration: 0.25, ease: 'power2.in' });
        });
      });
    }

    // 7. Subtle magnetic buttons
    document.querySelectorAll<HTMLElement>('.js-magnetic').forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.16;
        const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.2;
        gsap.to(btn, { x: dx, y: dy, duration: 0.3, ease: 'power2.out' });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });

    // 8. 3D-Tilt Metallic Digital Card
    const card = document.getElementById('metalCard');
    const sheen = document.getElementById('metalSheen');
    if (card && sheen) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        const rx = (0.5 - py) * 14;
        const ry = (px - 0.5) * 16;
        card.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
        sheen.style.setProperty('--mx', `${px * 100}%`);
        sheen.style.setProperty('--my', `${py * 100}%`);
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });
    }
  }
</script>