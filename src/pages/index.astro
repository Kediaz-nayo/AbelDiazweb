---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icons from '../components/Icons.astro';
import abelPortrait from '../assets/abeldiaz.jpeg';
import archInterior from '../assets/arch-interior.jpg';
import archCourtyard from '../assets/arch-courtyard.jpg';
import archSanctuary from '../assets/arch-sanctuary.jpg';
import archHorizon from '../assets/arch-horizon.jpg';
import { SITE, buildWhatsAppUrl } from '../data/site';

// Pre-optimize architectural preview photos for the cursor-following hover reveal
const [imgSanctuary, imgCourtyard, imgHorizon, imgInterior] = await Promise.all([
  getImage({ src: archSanctuary, width: 720, format: 'webp' }),
  getImage({ src: archCourtyard, width: 720, format: 'webp' }),
  getImage({ src: archHorizon, width: 720, format: 'webp' }),
  getImage({ src: archInterior, width: 720, format: 'webp' }),
]);

const serviceImages: Record<string, string> = {
  'gastos-medicos': imgSanctuary.src,
  'vida-e-incapacidad': imgCourtyard.src,
  'plan-de-retiro': imgHorizon.src,
  'ahorro-y-metas': imgInterior.src,
  'auto-y-hogar': imgCourtyard.src,
  'asesoria-patrimonial': imgHorizon.src,
};

const processPhotos = [archInterior, archSanctuary, archHorizon];

const manifestoWords =
  'No vendo pólizas en serie. Acompaño a personas, familias y empresarios en México y Estados Unidos a tomar decisiones financieras con claridad, respaldo real y trato directo.'.split(
    ' '
  );
---

<BaseLayout
  title={SITE.metaTitle}
  description={SITE.metaDescription}
  canonicalPath="/"
>
  <SiteHeader isHome={true} />

  <main id="contenido">
    <!-- =================================================================== -->
    <!-- 1. HERO MONUMENTAL + LIENZO ARQUITECTÓNICO EXPANDIBLE AL SCROLL     -->
    <!-- =================================================================== -->
    <section class="hero">
      <div class="container hero-top">
        <div class="hero-meta-row js-hero-fade">
          <span class="status-pill">
            <span class="status-dot" aria-hidden="true"></span>
            Asesor Patrimonial y de Seguros
          </span>
          <span class="hero-loc">{SITE.locations}</span>
        </div>

        <h1 class="hero-title">
          <span class="line-mask"><span class="line-inner js-hero-line">Tu patrimonio merece</span></span>
          <span class="line-mask">
            <span class="line-inner js-hero-line">
              claridad, <span class="serif-accent">sin letras chiquitas.</span>
            </span>
          </span>
        </h1>

        <div class="hero-bottom-row js-hero-fade">
          <p class="hero-lead">
            Soy <strong>Abel Díaz</strong>. Te ayudo a estructurar tu salud, tu vida, tu retiro y tu patrimonio con transparencia y acompañamiento personal.
          </p>

          <div class="hero-actions">
            <a
              href={buildWhatsAppUrl()}
              class="btn btn-obsidian js-magnetic"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icons name="whatsapp" size={18} />
              <span>Escribir por WhatsApp</span>
            </a>

            <a
              href={SITE.contact.vcardUrl}
              download="Abel-Diaz-Asesor.vcf"
              class="btn btn-outline js-magnetic"
            >
              <Icons name="contact-card" size={18} />
              <span>Guardar contacto</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Lienzo panorámico que se expande a ancho completo al hacer scroll -->
      <div class="hero-stage-outer" id="heroStageOuter">
        <div class="hero-stage" id="heroStage">
          <Image
            src={archInterior}
            alt="Espacio arquitectónico contemporáneo en luz natural"
            width={1600}
            height={900}
            loading="eager"
            fetchpriority="high"
            class="hero-stage-img"
            id="heroStageImg"
          />
          <div class="hero-stage-scrim"></div>

          <div class="hero-stage-hud">
            <div class="advisor-pill">
              <Image
                src={abelPortrait}
                alt="Abel Díaz"
                width={120}
                height={120}
                loading="eager"
                class="advisor-thumb"
              />
              <div>
                <strong>{SITE.name}</strong>
                <span>{SITE.contact.phoneDisplay} · @{SITE.contact.instagramHandle}</span>
              </div>
            </div>

            <a href="#acerca" class="scroll-cue">
              <span>Explorar</span>
              <span class="scroll-line" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 2. MANIFIESTO ILUMINADO PALABRA POR PALABRA AL SCROLL               -->
    <!-- =================================================================== -->
    <section class="manifesto-section" id="manifiesto">
      <div class="container">
        <span class="eyebrow">Filosofía de trabajo</span>
        <p class="manifesto-text" id="manifestoText">
          {manifestoWords.map((word) => (
            <span class="m-word">{word}{' '}</span>
          ))}
        </p>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 3. STICKY SPLIT: RETRATO ANCLADO + PRINCIPIOS + ASEGURADORAS        -->
    <!-- =================================================================== -->
    <section class="about-section" id="acerca">
      <div class="container about-grid">
        <div class="about-sticky">
          <div class="portrait-card">
            <Image
              src={abelPortrait}
              alt="Retrato de Abel Díaz, asesor patrimonial y de seguros"
              width={720}
              height={880}
              class="portrait-photo"
            />
            <div class="portrait-gradient"></div>
            <div class="portrait-overlay">
              <div>
                <p class="portrait-name">{SITE.name}</p>
                <p class="portrait-sub">{SITE.credentials.coverageValue}</p>
              </div>
              <span class="cedula-pill">{SITE.credentials.cedulaLabel}</span>
            </div>
          </div>
        </div>

        <div class="about-content">
          <span class="eyebrow">Acerca de mí</span>
          <h2>
            Un asesor cercano que responde <span class="serif-accent">cuando importa.</span>
          </h2>
          <p class="about-intro">
            {SITE.about.paragraphs[0]}
          </p>
          <p class="about-intro">
            {SITE.about.paragraphs[1]}
          </p>

          <div class="principles-stack">
            {SITE.about.principles.map((item, idx) => (
              <article class="principle-card js-reveal-up">
                <span class="p-index">0{idx + 1}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="credentials-grid js-reveal-up">
            <div class="cred-box">
              <span>{SITE.credentials.cedulaLabel}</span>
              <strong>{SITE.credentials.cedulaValue}</strong>
            </div>
            <div class="cred-box">
              <span>{SITE.credentials.coverageLabel}</span>
              <strong>{SITE.credentials.coverageValue}</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Banda sutil cinética de aseguradoras (placeholder) -->
      <div class="insurers-marquee-wrap" aria-label={SITE.insurersNote}>
        <div class="container">
          <p class="insurers-caption">{SITE.insurersNote}</p>
        </div>
        <div class="marquee-viewport">
          <div class="marquee-track">
            {[...SITE.insurers, ...SITE.insurers, ...SITE.insurers].map((insurer) => (
              <span class="marquee-item">
                {insurer}
                <span class="marquee-sep" aria-hidden="true">✦</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 4. CAPÍTULO OBSIDIANA: SERVICIOS CON PREVIEW FLOTANTE AL CURSOR     -->
    <!-- =================================================================== -->
    <section class="services-obsidian" id="servicios" data-theme="dark">
      <div class="obsidian-glow" aria-hidden="true"></div>

      <!-- Vista previa fotográfica flotante (solo escritorio) -->
      <div class="hover-preview" id="hoverPreview" aria-hidden="true">
        <img src={imgSanctuary.src} alt="" id="hoverPreviewImg" />
      </div>

      <div class="container services-inner">
        <div class="services-head">
          <div>
            <span class="eyebrow eyebrow-gold">Coberturas</span>
            <h2>
              Soluciones diseñadas <span class="serif-accent">alrededor de tu vida.</span>
            </h2>
          </div>
          <p class="services-sub">
            Explora cada área para conocer detalles y preguntas frecuentes, o escríbeme directo por WhatsApp.
          </p>
        </div>

        <div class="services-list" id="servicesList">
          {SITE.services.map((service, index) => (
            <div
              class="service-row"
              data-preview-img={serviceImages[service.slug]}
            >
              <a href={`/servicios/${service.slug}`} class="service-row-main">
                <span class="s-num">0{index + 1}</span>
                <div class="s-text">
                  <span class="s-cat">{service.category}</span>
                  <h3>{service.shortTitle}</h3>
                  <p>{service.summary}</p>
                </div>
                <span class="s-arrow" aria-hidden="true">
                  <Icons name="arrow-up-right" size={22} />
                </span>
              </a>

              <div class="service-row-actions">
                <a href={`/servicios/${service.slug}`} class="s-detail-link">
                  Ver ficha completa
                </a>
                <a
                  href={buildWhatsAppUrl(service.whatsappMessage)}
                  class="s-wa-pill"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icons name="whatsapp" size={15} />
                  <span>Consultar</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 5. TARJETAS APILABLES AL SCROLL: CÓMO ES UNA ASESORÍA CONMIGO       -->
    <!-- =================================================================== -->
    <section class="process-section" id="proceso">
      <div class="container">
        <div class="process-head">
          <span class="eyebrow">Proceso</span>
          <h2>
            Tres pasos claros, <span class="serif-accent">sin presión comercial.</span>
          </h2>
        </div>

        <div class="stack-wrap">
          {SITE.process.steps.map((step, index) => (
            <article class="stack-card js-stack-card" style={`--stack-idx: ${index};`}>
              <div class="stack-card-copy">
                <span class="stack-step">0{index + 1} · {step.label}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                <a
                  href={buildWhatsAppUrl()}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="stack-cta"
                >
                  <span>Empezar conversación</span>
                  <Icons name="arrow-right" size={16} />
                </a>
              </div>
              <div class="stack-card-media">
                <Image
                  src={processPhotos[index]}
                  alt={step.title}
                  width={840}
                  height={600}
                  class="stack-img"
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 6. TESTIMONIOS EN TRAVERTINO                                        -->
    <!-- =================================================================== -->
    <section class="testimonials-section" id="testimonios">
      <div class="container">
        <div class="test-head">
          <span class="eyebrow">Confianza</span>
          <h2>Lo que valoran quienes ya trabajan conmigo.</h2>
        </div>

        <div class="test-grid">
          {SITE.testimonials.items.map((item) => (
            <blockquote class="test-card js-reveal-up">
              <p class="test-quote">“{item.quote}”</p>
              <footer class="test-footer">
                <cite>{item.author}</cite>
                <span>{item.context}</span>
              </footer>
            </blockquote>
          ))}
        </div>
        <p class="test-note">{SITE.testimonials.note}</p>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 7. CIERRE MONUMENTAL + TARJETA METÁLICA 3D INTERACTIVA              -->
    <!-- =================================================================== -->
    <section class="contact-finale" id="contacto" data-theme="dark">
      <div class="finale-glow" aria-hidden="true"></div>

      <div class="container finale-grid">
        <div class="finale-left">
          <span class="eyebrow eyebrow-gold">Contacto directo</span>
          <h2 class="finale-title">
            Hablemos <span class="serif-accent">con calma.</span>
          </h2>
          <p class="finale-lead">
            {SITE.contactSection.lead}
          </p>

          <div class="finale-ctas">
            <a
              href={buildWhatsAppUrl()}
              class="btn btn-light js-magnetic"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icons name="whatsapp" size={18} />
              <span>Escribir por WhatsApp</span>
            </a>

            <a
              href={SITE.contact.vcardUrl}
              download="Abel-Diaz-Asesor.vcf"
              class="btn btn-ghost-dark js-magnetic"
            >
              <Icons name="contact-card" size={18} />
              <span>Guardar contacto</span>
            </a>
          </div>

          <div class="finale-direct">
            <a href={`tel:+${SITE.contact.phoneRaw}`} class="direct-item">
              <span>Teléfono</span>
              <strong>{SITE.contact.phoneDisplay}</strong>
            </a>
            <a href={`mailto:${SITE.contact.email}`} class="direct-item">
              <span>Correo</span>
              <strong>{SITE.contact.email}</strong>
            </a>
            <a
              href={SITE.contact.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="direct-item"
            >
              <span>Instagram</span>
              <strong>@{SITE.contact.instagramHandle} ↗</strong>
            </a>
            <a
              href={SITE.contact.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="direct-item"
            >
              <span>LinkedIn</span>
              <strong>Abel Díaz ↗</strong>
            </a>
          </div>
        </div>

        <!-- Tarjeta metálica interactiva 3D con brillo especular -->
        <div class="finale-right">
          <a href="/tarjeta" class="metal-card-scene" aria-label="Abrir tarjeta digital y código QR de Abel Díaz">
            <div class="metal-card" id="metalCard">
              <div class="metal-sheen" id="metalSheen"></div>
              <div class="metal-top">
                <div class="metal-logo">
                  <svg width="34" height="34" viewBox="0 0 64 64" fill="none">
                    <rect width="64" height="64" rx="14" fill="rgba(214,181,113,0.12)" stroke="rgba(214,181,113,0.4)" stroke-width="2" />
                    <path d="M32 11L49 18V31.5C49 42.6 41.5 50.8 32 54C22.5 50.8 15 42.6 15 31.5V18L32 11Z" stroke="#D6B571" stroke-width="2.6" stroke-linejoin="round" />
                    <path d="M23 42L32 21L41 42" stroke="#D6B571" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M27.5 42L32 32.5L36.5 42" fill="#D6B571" />
                  </svg>
                  <span>TARJETA DIGITAL</span>
                </div>
                <Icons name="qr" size={22} />
              </div>

              <div class="metal-mid">
                <Image
                  src={abelPortrait}
                  alt="Abel Díaz"
                  width={120}
                  height={120}
                  class="metal-avatar"
                />
                <div>
                  <strong>{SITE.name}</strong>
                  <span>{SITE.role}</span>
                </div>
              </div>

              <div class="metal-bottom">
                <span>{SITE.contact.phoneDisplay}</span>
                <span class="metal-open">Abrir tarjeta + QR →</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ================= 1. HERO MONUMENTAL ================= */
  .hero {
    padding-top: clamp(6.75rem, 11vw, 9rem);
    background-color: var(--bg-chalk);
  }

  .hero-top {
    padding-bottom: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-primary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
  }

  .hero-loc {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .hero-title {
    font-size: clamp(2.85rem, 7vw, 6.25rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    color: var(--ink-primary);
    max-width: 17ch;
  }

  .hero-title .serif-accent {
    font-size: 1.07em;
    font-weight: 400;
    color: var(--ink-primary);
  }

  .line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .line-inner {
    display: block;
  }

  .hero-bottom-row {
    margin-top: clamp(2rem, 4vw, 3.25rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
  }

  .hero-lead {
    font-size: clamp(1.04rem, 1.35vw, 1.2rem);
    line-height: 1.65;
    color: var(--ink-secondary);
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Lienzo expandible */
  .hero-stage-outer {
    padding-inline: clamp(0.75rem, 2.6vw, 2.5rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    height: clamp(360px, 66vh, 680px);
    border-radius: 28px;
    overflow: hidden;
    background: var(--bg-obsidian);
    box-shadow: 0 32px 80px rgba(9, 12, 18, 0.16);
    will-change: transform, border-radius;
  }

  .hero-stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    will-change: transform;
  }

  .hero-stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 12, 18, 0.04) 20%,
      rgba(9, 12, 18, 0.56) 100%
    );
  }

  .hero-stage-hud {
    position: absolute;
    left: clamp(1.15rem, 3vw, 2.5rem);
    right: clamp(1.15rem, 3vw, 2.5rem);
    bottom: clamp(1.15rem, 3vw, 2.25rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
  }

  .advisor-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.55rem 1.1rem 0.55rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    color: var(--ink-primary);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
  }

  .advisor-thumb {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    flex-shrink: 0;
  }

  .advisor-pill strong {
    display: block;
    font-size: 0.9rem;
    line-height: 1.15;
  }

  .advisor-pill span {
    font-size: 0.78rem;
    color: var(--ink-secondary);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .scroll-line {
    width: 34px;
    height: 1px;
    background: rgba(255, 255, 255, 0.7);
  }

  /* ================= 2. MANIFIESTO ILUMINADO ================= */
  .manifesto-section {
    padding-block: clamp(5rem, 11vw, 9.5rem);
    background: var(--bg-chalk);
  }

  .manifesto-text {
    margin-top: 1.75rem;
    font-size: clamp(1.85rem, 4vw, 3.65rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.035em;
    color: var(--ink-primary);
    max-width: 28ch;
  }

  .m-word {
    display: inline;
    opacity: 0.16;
    transition: opacity 0.15s linear;
  }

  /* ================= 3. STICKY SPLIT ACERCA ================= */
  .about-section {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
    background: var(--bg-chalk);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .about-sticky {
    position: sticky;
    top: 102px;
  }

  .portrait-card {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 4 / 4.85;
    background: var(--bg-obsidian);
    box-shadow: 0 28px 65px rgba(9, 12, 18, 0.14);
  }

  .portrait-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .portrait-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(9, 12, 18, 0.86) 100%);
  }

  .portrait-overlay {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    color: #ffffff;
  }

  .portrait-name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .portrait-sub {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .cedula-pill {
    padding: 0.36rem 0.8rem;
    border-radius: 999px;
    background: rgba(214, 181, 113, 0.2);
    border: 1px solid rgba(214, 181, 113, 0.5);
    color: #f4dca6;
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .about-content h2 {
    margin-top: 1.15rem;
    font-size: clamp(2rem, 3.8vw, 3.35rem);
    line-height: 1.08;
  }

  .about-content h2 .serif-accent {
