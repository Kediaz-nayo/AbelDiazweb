---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Filosofia from '../components/Filosofia.astro';
---

<Layout 
  title="Abel Díaz - Asesor Financiero y Patrimonial"
  description="Acompañamiento financiero y patrimonial para tomar mejores decisiones. Claridad hoy, tranquilidad mañana."
>
  <Header />
  <main>
    <Hero />
    
    <!-- Sobre mí section - brief intro before philosophy -->
    <section id="sobre-mi" class="section container" style="min-height: 30vh;">
      <h2>Sobre mí</h2>
      <p>Sección en desarrollo...</p>
    </section>
    
    <Filosofia />
    
    <section id="servicios" class="section container" style="min-height: 50vh;">
      <h2>Servicios</h2>
      <p>Sección en desarrollo...</p>
    </section>
    
    <section id="contacto" class="section container" style="min-height: 50vh;">
      <h2>Contacto</h2>
      <p>Sección en desarrollo...</p>
    </section>
  </main>
</Layout>

<style>
  main {
    overflow-x: hidden;
  }
</style>
