---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icons from '../../components/Icons.astro';
import { SITE, buildWhatsAppUrl, type ServiceItem } from '../../data/site';

export function getStaticPaths() {
  return SITE.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const otherServices = SITE.services.filter((item) => item.slug !== service.slug);
---

<BaseLayout
  title={`${service.shortTitle} — ${SITE.name}`}
  description={service.summary}
  canonicalPath={`/servicios/${service.slug}`}
>
  <SiteHeader isHome={false} />

  <main id="contenido">
    <section class="service-hero">
      <div class="container">
        <div class="service-hero-inner">
          <a href="/#servicios" class="back-link">
            <Icons name="arrow-left" size={16} />
            <span>Todos los servicios</span>
          </a>

          <span class="section-kicker">{service.category}</span>
          <h1>{service.title}</h1>
          <p class="lead service-intro">{service.detailIntro}</p>

          <div class="service-hero-actions">
            <a
              href={buildWhatsAppUrl(service.whatsappMessage)}
              class="btn btn-whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icons name="whatsapp" size={18} />
              <span>Preguntar por WhatsApp</span>
            </a>

            <a href={`mailto:${SITE.contact.email}?subject=${encodeURIComponent(`Consulta: ${service.shortTitle}`)}`} class="btn btn-secondary">
              <Icons name="mail" size={18} />
              <span>Enviar correo</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-linen">
      <div class="container detail-grid">
        <div class="detail-column">
          <h2>Qué protege y cómo ayuda</h2>
          <ul class="detail-list">
            {service.whatItProtects.map((point) => (
              <li>
                <span class="list-icon" aria-hidden="true">
                  <Icons name="check" size={16} />
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="detail-column">
          <h2>Ideal para ti si…</h2>
          <ul class="detail-list">
            {service.whoItIsFor.map((point) => (
              <li>
                <span class="list-icon" aria-hidden="true">
                  <Icons name="check" size={16} />
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-layout">
        <div class="faq-header">
          <span class="section-kicker">Preguntas frecuentes</span>
          <h2>Dudas comunes antes de contratar</h2>
        </div>

        <div class="faq-list">
          {service.faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-dark service-cta-band">
      <div class="container service-cta-inner">
        <div>
          <span class="section-kicker">Asesoría sin compromiso</span>
          <h2>¿Quieres revisar opciones de {service.shortTitle.toLowerCase()} para tu caso?</h2>
          <p class="cta-text">
            Escríbeme por WhatsApp y coordinamos una plática breve para comparar alternativas claras según tu presupuesto.
          </p>
        </div>

        <div class="cta-actions">
          <a
            href={buildWhatsAppUrl(service.whatsappMessage)}
            class="btn btn-light"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icons name="whatsapp" size={18} />
            <span>Hablar con Abel</span>
          </a>
          <a href={SITE.contact.vcardUrl} download="Abel-Diaz-Asesor.vcf" class="btn btn-ghost-dark">
            <Icons name="contact-card" size={18} />
            <span>Guardar contacto</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="related-heading">Otras coberturas</h2>
        <div class="related-grid">
          {otherServices.map((item) => (
            <a href={`/servicios/${item.slug}`} class="related-card">
              <span class="related-category">{item.category}</span>
              <span class="related-title">{item.shortTitle}</span>
              <span class="related-arrow" aria-hidden="true">
                <Icons name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .service-hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 5vw, 4.5rem);
  }

  .service-hero-inner {
    max-width: 820px;
    margin-inline: 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 1.75rem;
    transition: color var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--ink-navy);
  }

  .service-intro {
    margin-top: 1.35rem;
  }

  .service-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .detail-column h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 1.5rem;
  }

  .detail-list {
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .detail-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--border-hairline);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .list-icon {
    color: var(--brass);
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .faq-list {
    border-top: 1px solid var(--border-strong);
  }

  .faq-item {
    border-bottom: 1px solid var(--border-hairline);
  }

  .faq-question {
    list-style: none;
    cursor: pointer;
    padding-block: 1.25rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink-navy);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--brass);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding-bottom: 1.35rem;
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .service-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .service-cta-inner h2 {
    max-width: 24ch;
  }

  .cta-text {
    margin-top: 0.85rem;
    color: var(--ink-on-dark-muted);
    max-width: 54ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .related-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.35rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-editorial);
  }

  .related-card:hover {
    border-color: var(--ink-navy);
    transform: translateY(-2px);
  }

  .related-category {
    font-size: 0.78rem;
    color: var(--brass);
    font-weight: 500;
  }

  .related-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--ink-navy);
  }

  .related-arrow {
    margin-top: 0.4rem;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .detail-grid,
    .faq-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .service-hero-actions .btn,
    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
