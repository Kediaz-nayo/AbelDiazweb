---
interface Props {
  title: string;
  description: string;
}

const { 
  title = 'Abel Díaz - Asesor Financiero y Patrimonial', 
  description = 'Acompañamiento financiero y patrimonial para tomar mejores decisiones. Claridad hoy, tranquilidad mañana.' 
} = Astro.props;

const siteUrl = 'https://abeldiaz.pro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Abel Díaz" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="es" />
    <meta name="keywords" content="asesor financiero, asesoría patrimonial, planificación financiera, seguros de vida, protección patrimonial, Abel Díaz, México, consultoría financiera" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.jpeg" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/abeldiaz.jpeg`} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Abel Díaz" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/abeldiaz.jpeg`} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={siteUrl} />
    
    <!-- Google Fonts - Optimized Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700;900&display=swap" 
      rel="stylesheet" 
    />
    
    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Abel Díaz",
        "jobTitle": "Asesor Financiero y Patrimonial",
        "description": "Acompañamiento financiero y patrimonial para tomar mejores decisiones",
        "url": "https://abeldiaz.pro",
        "sameAs": [
          "https://wa.me/+524495478201"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+52-449-547-8201",
          "contactType": "customer service",
          "availableLanguage": "Spanish"
        }
      }
    </script>
  </head>
  
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
