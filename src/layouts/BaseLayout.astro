---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImagePath?: string;
  hideFloatingWhatsApp?: boolean;
}

const {
  title = SITE.metaTitle,
  description = SITE.metaDescription,
  canonicalPath = '/',
  ogImagePath = '/og-image.png',
  hideFloatingWhatsApp = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE.url).toString();
const ogImageUrl = new URL(ogImagePath, SITE.url).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  description: SITE.metaDescription,
  url: SITE.url,
  email: `mailto:${SITE.contact.email}`,
  telephone: SITE.contact.phoneDisplay,
  sameAs: [SITE.contact.instagramUrl, SITE.contact.linkedinUrl],
  areaServed: ['MX', 'US'],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#132238" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={`${SITE.name} — ${SITE.role}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Newsreader (editorial serif) + Plus Jakarta Sans (humanist sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Ir al contenido principal</a>
    <slot />

    {!hideFloatingWhatsApp && (
      <a
        href={`https://wa.me/${SITE.contact.phoneRaw}?text=${encodeURIComponent(SITE.contact.whatsappDefaultMessage)}`}
        class="floating-wa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribir a Abel Díaz por WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
          <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a4 4 0 0 1 -4 -4v-1a.5 .5 0 0 0 -1 0v1" />
        </svg>
        <span>WhatsApp</span>
      </a>
    )}

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                const delay = Number(target.dataset.delay || '0');
                if (delay > 0) {
                  target.style.transitionDelay = `${delay}ms`;
                }
                target.classList.add('is-visible');
                observer.unobserve(target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .floating-wa {
    display: none;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    align-items: center;
    gap: 0.5rem;
    padding: 0.72rem 1.05rem;
    border-radius: 999px;
    background-color: var(--whatsapp);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 8px 24px rgba(19, 34, 56, 0.24);
    transition:
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-editorial);
  }

  .floating-wa:hover {
    background-color: var(--whatsapp-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 860px) {
    .floating-wa {
      display: inline-flex;
    }
  }
</style>
