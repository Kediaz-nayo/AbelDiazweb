---
import BrandMark from './BrandMark.astro';
import Icons from './Icons.astro';
import { SITE } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label="Abel Díaz — Inicio">
          <BrandMark variant="dark" showRole={true} />
        </a>
        <p class="footer-locations">{SITE.locations}</p>
      </div>

      <div class="footer-columns">
        <div class="footer-col">
          <p class="footer-col-title">Contacto directo</p>
          <ul class="footer-list">
            <li>
              <a href={`tel:+${SITE.contact.phoneRaw}`}>
                {SITE.contact.phoneDisplay}
              </a>
            </li>
            <li>
              <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
            </li>
            <li>
              <a href={SITE.contact.vcardUrl} download="Abel-Diaz-Asesor.vcf">
                Guardar contacto (.vcf)
              </a>
            </li>
            <li>
              <a href="/tarjeta">Ver tarjeta digital</a>
            </li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-title">Redes sociales</p>
          <ul class="footer-list">
            <li>
              <a
                href={SITE.contact.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-row"
              >
                <Icons name="instagram" size={16} />
                <span>@{SITE.contact.instagramHandle}</span>
              </a>
            </li>
            <li>
              <a
                href={SITE.contact.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-row"
              >
                <Icons name="linkedin" size={16} />
                <span>LinkedIn — Abel Díaz</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} {SITE.name}. Todos los derechos reservados.</p>
      <p class="footer-note">
        Información orientativa sujeta a condiciones generales de cada aseguradora.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ink-navy-deep);
    color: var(--ink-on-dark-muted);
    padding-block: 3.5rem 2.25rem;
    border-top: 1px solid var(--border-on-dark);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-on-dark);
  }

  .footer-brand {
    max-width: 340px;
  }

  .footer-locations {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--ink-on-dark-muted);
  }

  .footer-columns {
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brass-soft);
    margin-bottom: 0.85rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.925rem;
  }

  .footer-list a {
    color: var(--ink-on-dark);
    transition: color var(--duration-fast) ease;
  }

  .footer-list a:hover {
    color: var(--brass-soft);
  }

  .social-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    font-size: 0.825rem;
    color: var(--ink-on-dark-muted);
  }

  .footer-note {
    max-width: none;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }

    .footer-columns {
      gap: 2rem;
    }
  }
</style>
