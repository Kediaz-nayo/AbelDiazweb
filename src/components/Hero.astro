---
import abelPhoto from '../assets/abeldiaz.jpeg';
---

<section class="hero pattern-bg" id="hero">
  <div class="hero-container container">
    <!-- Mobile: Image first, then content -->
    <div class="hero-image-wrapper">
      <div class="hero-image">
        <img 
          src={abelPhoto.src} 
          alt="Abel Díaz - Asesor Financiero y Patrimonial" 
          loading="eager"
          decoding="async"
        />
      </div>
      <!-- Decorative frame -->
      <div class="image-frame"></div>
    </div>
    
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="title-line">Claridad hoy.</span>
        <span class="title-line">Tranquilidad mañana.</span>
      </h1>
      
      <p class="hero-subtitle">
        Acompañamiento financiero y patrimonial para tomar mejores decisiones.
      </p>
      
      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary" id="hero-cta-btn">
          Hablemos de tus metas
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-8);
    background-color: var(--color-off-white);
    position: relative;
    overflow: hidden;
  }
  
  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: center;
  }
  
  @media (min-width: 768px) {
    .hero {
      padding-top: 0;
      padding-bottom: 0;
    }
    
    .hero-container {
      flex-direction: row;
      gap: var(--space-12);
      min-height: 100vh;
    }
  }
  
  /* === HERO CONTENT === */
  .hero-content {
    flex: 1;
    text-align: center;
    order: 2;
  }
  
  @media (min-width: 768px) {
    .hero-content {
      text-align: left;
      order: 1;
      max-width: 560px;
    }
  }
  
  .hero-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-black);
    line-height: var(--leading-none);
    color: var(--color-navy-800);
    margin-bottom: var(--space-6);
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }
  
  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }
  
  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }
  
  .title-line {
    display: block;
  }
  
  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-gray-500);
    margin-bottom: var(--space-8);
    max-width: 480px;
    margin-inline: auto;
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.2s forwards;
  }
  
  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: var(--text-xl);
      margin-inline: 0;
    }
  }
  
  .hero-cta {
    opacity: 0;
    animation: fadeInUp 0.8s ease 0.4s forwards;
  }
  
  .hero-cta .btn {
    width: 100%;
    justify-content: center;
  }
  
  @media (min-width: 768px) {
    .hero-cta .btn {
      width: auto;
    }
  }
  
  /* === HERO IMAGE === */
  .hero-image-wrapper {
    position: relative;
    order: 1;
    width: 100%;
    max-width: 320px;
    opacity: 0;
    animation: fadeInRight 0.8s ease 0.3s forwards;
  }
  
  @media (min-width: 768px) {
    .hero-image-wrapper {
      order: 2;
      flex: 1;
      max-width: 480px;
    }
  }
  
  @media (min-width: 1024px) {
    .hero-image-wrapper {
      max-width: 520px;
    }
  }
  
  .hero-image {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }
  
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  
  /* Decorative frame behind image */
  .image-frame {
    position: absolute;
    top: var(--space-4);
    right: calc(var(--space-4) * -1);
    width: 100%;
    height: 100%;
    border: 2px solid var(--color-gold-500);
    border-radius: var(--radius-2xl);
    z-index: -1;
  }
  
  @media (min-width: 768px) {
    .image-frame {
      top: var(--space-6);
      right: calc(var(--space-6) * -1);
    }
  }
  
  /* === SCROLL INDICATOR === */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: none;
  }
  
  @media (min-width: 768px) {
    .scroll-indicator {
      display: block;
    }
  }
  
  .scroll-line {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-gray-300), transparent);
    border-radius: var(--radius-full);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  
  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.3;
      transform: scaleY(0.8);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }
  
  /* Animation keyframes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
